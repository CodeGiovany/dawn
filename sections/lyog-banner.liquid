{%- comment -%}
  Banner principal de LYOG (v2 minimalista): imagen grande, texto abajo a la izquierda.
  Uso: Personalizar > Agregar seccion > "LYOG - Banner".
{%- endcomment -%}
<section class="lyog-banner" style="background-color: {{ section.settings.fondo }}; min-height: {{ section.settings.alto }}px;">
  {%- if section.settings.imagen != blank -%}
    <div class="lyog-banner__imagen">
      {{ section.settings.imagen | image_url: width: 2400 | image_tag: loading: 'eager', alt: section.settings.titulo }}
    </div>
  {%- endif -%}
  <div class="lyog-banner__contenido page-width">
    <h1 class="lyog-banner__titulo">{{ section.settings.titulo }}</h1>
    {%- if section.settings.subtitulo != blank -%}
      <p class="lyog-banner__subtitulo">{{ section.settings.subtitulo }}</p>
    {%- endif -%}
    {%- if section.settings.boton_texto != blank -%}
      <a class="button" href="{{ section.settings.boton_enlace | default: routes.all_products_collection_url }}">
        {{ section.settings.boton_texto }}
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  .lyog-banner {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .lyog-banner__imagen { position: absolute; inset: 0; }
  .lyog-banner__imagen img { width: 100%; height: 100%; object-fit: cover; }
  .lyog-banner__contenido {
    position: relative;
    width: 100%;
    padding-top: 4rem;
    padding-bottom: 6.4rem;
  }
  .lyog-banner__titulo { margin: 0; color: #fff; }
  .lyog-banner__subtitulo {
    margin: 1.6rem 0 3.2rem;
    font-size: 1.8rem;
    color: #ddd;
  }
</style>

{% schema %}
{
  "name": "LYOG - Banner",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Titulo", "default": "Kuska - Usuchkan" },
    { "type": "text", "id": "subtitulo", "label": "Subtitulo", "default": "Polos y poleras oversize." },
    { "type": "text", "id": "boton_texto", "label": "Texto del boton", "default": "Ver coleccion" },
    { "type": "url", "id": "boton_enlace", "label": "Enlace del boton" },
    { "type": "image_picker", "id": "imagen", "label": "Imagen de fondo" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#151515" },
    { "type": "range", "id": "alto", "label": "Alto minimo (px)", "min": 320, "max": 800, "step": 20, "default": 560 }
  ],
  "presets": [{ "name": "LYOG - Banner" }]
}
{% endschema %}
