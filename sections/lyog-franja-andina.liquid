{%- comment -%}
  Franja decorativa con el patron andino de LYOG.
  Uso: Personalizar > Agregar seccion > "LYOG - Franja andina".
{%- endcomment -%}
<div
  class="lyog-franja"
  style="background-color: {{ section.settings.fondo }}; padding: {{ section.settings.espacio }}px 0;"
  role="presentation"
>
  <div
    class="lyog-franja__patron"
    style="height: {{ section.settings.alto }}px; background-image: url('{{ 'lyog-patron.svg' | asset_url }}');"
  ></div>
</div>

<style>
  .lyog-franja__patron {
    background-repeat: repeat-x;
    background-position: center;
    background-size: auto 100%;
  }
</style>

{% schema %}
{
  "name": "LYOG - Franja andina",
  "settings": [
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#000000" },
    { "type": "range", "id": "alto", "label": "Alto del patron (px)", "min": 16, "max": 120, "step": 4, "default": 24 },
    { "type": "range", "id": "espacio", "label": "Espacio arriba y abajo (px)", "min": 0, "max": 64, "step": 4, "default": 0 }
  ],
  "presets": [{ "name": "LYOG - Franja andina" }]
}
{% endschema %}
